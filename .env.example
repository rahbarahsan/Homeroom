# Copy to .env (gitignored) and fill in. NEVER commit .env.
# Teacher: pick a provider whose terms allow using outputs to train your model (see docs/decisions.md).
TEACHER_PROVIDER=openai_compatible     # openai_compatible | anthropic | mock
TEACHER_MODEL=                         # model id at your provider
TEACHER_BASE_URL=                      # e.g. provider's OpenAI-compatible URL; empty for api.openai.com
TEACHER_API_KEY=
# Current prices in USD per 1M tokens (check your provider's pricing page; runs refuse if unset)
TEACHER_PRICE_IN=
TEACHER_PRICE_OUT=
# Phase 2 (not used yet)
TYPESAFE_API_KEY=
